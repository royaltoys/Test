<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_grn_control" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.grn.control</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='advanced_operations']" position="inside">
                <div class="o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="grn_over_receipt_tolerance"
                               string="GRN Over-Receipt Tolerance"/>
                        <div class="text-muted">
                            Allow vendors to deliver a small % above PO quantity.
                            Set to 0 to block any over-receipt strictly.
                        </div>
                        <div class="mt8">
                            <field name="grn_over_receipt_tolerance" style="width:80px;"/>
                            <span> %</span>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
